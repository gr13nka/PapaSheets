<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- CameraCapture пишет temp-снимок в cacheDir/camera до его импорта в PhotoStore. -->
    <cache-path name="camera_temp" path="camera/" />
    <!-- AppLog склеивает файлы ротации для шаринга в cacheDir/logshare. -->
    <cache-path name="logshare" path="logshare/" />
</paths>
